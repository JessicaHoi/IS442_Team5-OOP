# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real credentials.
# Values are in the Supabase dashboard: Connect > Session pooler.

# The dashboard shows postgresql://user:password@<host>:5432/postgres. Don't paste that:
# copy only the host into the jdbc: form below (user and password go on their own lines).
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# Pooler usernames include the project ref: postgres.<project-ref>
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Uncomment for one run to create or update the tables, then comment it out again.
# SUPABASE_DDL_AUTO=update
