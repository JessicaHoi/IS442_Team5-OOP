# --- Runtime (exposed to the browser, must start with VITE_) ---
# true  = answer API calls from the in-memory mock (demo without a backend)
# false = call the real backend
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api
VITE_APP_NAME=StudyBuddy

# --- Build / dev-server only ---
# Where `vite dev` proxies /api requests.
BACKEND_URL=http://localhost:8080
# Where `npm run build` writes the bundle (default: Spring Boot static folder).
BUILD_OUT_DIR=../backend/src/main/resources/static
